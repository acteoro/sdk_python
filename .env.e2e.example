# Copiaza fisierul in .env.e2e (ignorat de git) si completeaza valorile.
#   cp .env.e2e.example .env.e2e

# Obligatoriu pentru testele cu cheie. Fara ea ruleaza doar testul de cheie invalida.
ACTEO_API_KEY=

# Optional: alt mediu decat productia.
# ACTEO_BASE_URL=https://api.acteo.ro

# Vehiculul folosit in teste. Pune o masina a ta, niciodata date in repo.
ACTEO_E2E_NUMAR=
ACTEO_E2E_VIN=

# Verificari reale: consuma din cota planului API si interogheaza sursele oficiale.
# Cu NUMAR: 1 verificare RCA. Cu VIN in plus: inca 1 verificare ITP.
ACTEO_E2E_VERIFICARI=0

# Flota: adauga vehiculul de mai sus si il sterge la final. Nu consuma din cota,
# dar ocupa temporar un loc din plan si porneste verificarile automate ale contului.
ACTEO_E2E_FLOTA=0
